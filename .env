# Safe local defaults.
START_MODE=local
COMPOSE_PROFILES=local
BRAIN4ALL_DOMAIN=localhost
BRAIN4ALL_HTTP_PORT=5152
BRAIN4ALL_BACKEND_IMAGE=brain4all-backend:local
BRAIN4ALL_FRONTEND_IMAGE=brain4all-frontend:local
BRAIN4ALL_HERMES_IMAGE=brain4all-hermes-runtime:compatible
DASHBOARD_ENABLED=true
DASHBOARD_SMOKE_DATA_ENABLED=true
CLICKHOUSE_PASSWORD=brain4all-local
CLICKHOUSE_RETENTION_DAYS=7
BRAIN4ALL_EDITION=opensource
HTTP_PORT=3000
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DATA_DIR=data
FRONTEND_DIR=frontend/dist
HERMES_BIN=hermes
HERMES_GATEWAY_BIN=hermes-custom-gateway
HERMES_RUNTIME_MODE=cli
HERMES_RUNTIME_URL=
HERMES_RUNTIME_TOKEN=
NINE_ROUTER_URL=http://127.0.0.1:20128
NINE_ROUTER_DATA_DIR=data/root/.9router
RUNTIME_TIMEOUT_SECONDS=900
CONTAINER_IDLE_ENABLED=true
CONTAINER_IDLE_TIMEOUT_MINUTES=30
MAX_OPEN_SOURCE_AGENTS=4
MAX_OPEN_SOURCE_CRON_JOBS=4
MAX_OPEN_SOURCE_CRON_CONCURRENCY=1
MAX_OPEN_SOURCE_CRON_RUNS_PER_DAY=10
MAX_OPEN_SOURCE_CRON_RUNS_PER_MONTH=200
MAX_OPEN_SOURCE_PROVIDER_CONNECTIONS_PER_TYPE=1
MAX_OPEN_SOURCE_TEAMS=1
MAX_OPEN_SOURCE_AGENTS_PER_TEAM=2
MAX_OPEN_SOURCE_DELEGATED_WORKERS=1
MAX_OPEN_SOURCE_DELEGATION_DEPTH=1
PERMISSION_GRPC_HOST=
AUTH_TIMEOUT_SECONDS=1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_DISK_BUFFER_BYTES=67108864
DEVICE_CLOUD_URL=
DEVICE_SIGNING_PUBLIC_KEY=
DEVICE_POLL_INTERVAL_SECONDS=20
VITE_API_BASE_URL=http://localhost:3000
