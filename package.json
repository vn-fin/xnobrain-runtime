{
  "name": "xnobrain-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bash ./scripts/dev.sh",
    "dev:frontend": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "build:containers": "make build",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run --config vite.config.ts",
    "test:watch": "vitest --config vite.config.ts"
  },
  "dependencies": {
    "@fortune-sheet/react": "^1.0.4",
    "dompurify": "^3.4.12",
    "highlight.js": "11.11.1",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "katex": "0.16.47",
    "lucide-react": "^1.24.0",
    "luckyexcel": "^1.0.1",
    "papaparse": "^5.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-markdown": "9.0.1",
    "rehype-highlight": "7.0.1",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.0",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.25",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
