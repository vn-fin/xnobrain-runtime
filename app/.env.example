# Copy to app/.env or pass these values directly to make.
# Runtime images must be published multi-architecture images pinned by registry digest.
XNOBRAIN_RELEASE=0.1.0-dev
XNOBRAIN_APP_NAME=XNOBrain
XNOBRAIN_APP_DESCRIPTION=Install and run the private XNOBrain Docker Web workspace.
XNOBRAIN_DEFAULT_PORT=5152
XNOBRAIN_AUTH_BASE_URL=https://api.dev.xnoquant.io
XNOBRAIN_BRAIN_CONTROL_BASE_URL=https://api.dev.xnoquant.io
XNOBRAIN_WEB_EDITION=enterprise
XNOBRAIN_FIREBASE_API_KEY=AIza_REPLACE_WITH_THE_COMPLETE_PUBLIC_WEB_API_KEY
XNOBRAIN_TRAEFIK_IMAGE=traefik@sha256:f79c88ed5252ae1e31c757a9796d751461ddb502437b8d8526db9e12605a82eb
XNOBRAIN_IMAGE=registry.example/xnobrain@sha256:REPLACE_WITH_64_HEX_CHARACTERS
XNOBRAIN_RUNTIME_API_IMAGE=registry.example/xnobrain-runtime-api@sha256:REPLACE_WITH_64_HEX_CHARACTERS

# Release-only native signing gate. Keep disabled for local developer builds.
XNOBRAIN_REQUIRE_SIGNING=0
# XNOBRAIN_WINDOWS_CERTIFICATE_THUMBPRINT=40_HEXADECIMAL_CHARACTERS
# XNOBRAIN_WINDOWS_TIMESTAMP_URL=http://timestamp.digicert.com
# macOS signing/notarization uses Tauri's APPLE_SIGNING_IDENTITY and APPLE_* variables.

# Official Docker Desktop download locations can be overridden by release automation.
XNOBRAIN_DOCKER_WINDOWS_URL=https://desktop.docker.com/win/main/amd64/234817/Docker%20Desktop%20Installer.exe
XNOBRAIN_DOCKER_WINDOWS_SHA256=fe54164c1ceb9e2004137e22e4013826baccf2352c1cedb27e8daa8e56230dd7
XNOBRAIN_DOCKER_MACOS_ARM64_URL=https://desktop.docker.com/mac/main/arm64/234817/Docker.dmg
XNOBRAIN_DOCKER_MACOS_ARM64_SHA256=ed9e93bf2b71c53492eb80ef35e722e131222018cba8157973dfe3bb717952dd
XNOBRAIN_DOCKER_MACOS_AMD64_URL=https://desktop.docker.com/mac/main/amd64/234817/Docker.dmg
XNOBRAIN_DOCKER_MACOS_AMD64_SHA256=5e42979b75b13d516e3bfe69b93f134c3a48c76943cba068fd814007f922bf87
