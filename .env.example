START_MODE=local
OPEN_LUMORA_DOMAIN=localhost
OPEN_LUMORA_HTTP_PORT=80
OPEN_LUMORA_BACKEND_IMAGE=open-lumora-backend:local
OPEN_LUMORA_FRONTEND_IMAGE=open-lumora-frontend:local
HERMES_RUNTIME_IMAGE=open-lumora-hermes-runtime:local
OPEN_LUMORA_ENTERPRISE_API_IMAGE=open-lumora-gateway:local
OPEN_LUMORA_GATEWAY_URL=http://open-lumora-gateway:3100
HERMES_RUNTIME_TOKEN=open-lumora-local-runtime
NINE_ROUTER_INTERNAL_SECRET=open-lumora-local-9router
POSTGRES_PASSWORD=open_lumora
# Required only for signed-in Enterprise API mode.
AUTH_SERVICE_BASE_URL=
AUTH_GRPC_INSECURE=false
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=open_lumora
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
TELEMETRY_RESOURCE_TOKEN=
TELEMETRY_RESOURCE_TENANT_ID=
DASHBOARD_ENABLED=true
DASHBOARD_SMOKE_DATA_ENABLED=true
# Host development uses the gateway's loopback-published port.
CONTROL_GATEWAY_URL=http://localhost:3100
OPEN_LUMORA_EDITION=opensource
HTTP_PORT=3000
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DATA_DIR=data
FRONTEND_DIR=src/dist
NINE_ROUTER_DATA_DIR=data/root/.9router
RUNTIME_TIMEOUT_SECONDS=900
CONTAINER_IDLE_ENABLED=true
CONTAINER_IDLE_TIMEOUT_MINUTES=30
MANAGED_WORKER_TOKEN=
PERMISSION_GRPC_HOST=
AUTH_TIMEOUT_SECONDS=1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_DISK_BUFFER_BYTES=67108864
DEVICE_CLOUD_URL=
# Base64url Ed25519 public key supplied by the paired control plane.
DEVICE_SIGNING_PUBLIC_KEY=
DEVICE_POLL_INTERVAL_SECONDS=20
VITE_API_BASE_URL=http://localhost:3000
SCHEDULER_ENABLED=false
