BRAIN4ALL_DOMAIN=localhost
BRAIN4ALL_HTTP_PORT=5152
BRAIN4ALL_FRONTEND_IMAGE=brain4all-frontend:local
HERMES_RUNTIME_IMAGE=brain4all-hermes-runtime:local
# Runtime limits. Increase these values in .env when the host has capacity.
BRAIN4ALL_RUNTIME_CPUS=4.0
BRAIN4ALL_RUNTIME_MEMORY=4G
BRAIN4ALL_RUNTIME_DISK_SIZE=100G
NINE_ROUTER_INTERNAL_SECRET=brain4all-local-9router
API_SERVER_PORT=8642
LOG_LEVEL=debug
DEVELOPMENT_ENVIRONMENT=dev
SERVICE_NAME=runtime
DATA_DIR=data
# Hermes and 9router use their standard $HOME/.hermes and $HOME/.9router homes.
# Disabled by default. To enable the local collector, run:
# OTEL_ENABLED=true docker compose --profile otel up --build
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Empty uses same-origin requests through Traefik. Vite proxies to port 8642.
VITE_API_BASE_URL=
# Optional standalone CronService PostgreSQL store. When unset, cron jobs use
# the profile-local atomic file repository.
BRAIN4ALL_CRON_POSTGRES_HOST=
BRAIN4ALL_CRON_POSTGRES_DOCKER_HOST=host.docker.internal
BRAIN4ALL_CRON_POSTGRES_PORT=5432
BRAIN4ALL_CRON_POSTGRES_USER=postgres
BRAIN4ALL_CRON_POSTGRES_PASSWORD=
BRAIN4ALL_CRON_POSTGRES_DB=postgres
