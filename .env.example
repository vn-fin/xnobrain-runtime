# Copy this file to .env before running the runtime locally.

# Shared XNOBrain application and authentication settings.
XNOBRAIN_APP_NAME=XNOBrain
XNOBRAIN_APP_DESCRIPTION=Your private AI workspace for agents, conversations, skills, and automation.
XNOBRAIN_WEB_EDITION=enterprise
XNOBRAIN_AUTH_BASE_URL=https://api.dev.xnoquant.io
XNOBRAIN_BRAIN_CONTROL_BASE_URL=https://public.dev.xno.vn
XNOBRAIN_FIREBASE_API_KEY=replace-with-your-firebase-web-key

# The web port is published by the root Traefik stack. Backend APIs remain
# private and use the stack's internal service port.
XNOBRAIN_DEV_WEB_HOST=0.0.0.0
XNOBRAIN_DEV_WEB_PORT=5173

# Runtime persistent data.
RUNTIME_HERMES_HOME=/opt/data/agent
RUNTIME_LLM_GATEWAY_URL=http://control-api:3000/xnobrain/api/control/v1/llm/v1
RUNTIME_LLM_MANAGEMENT_URL=http://control-api:3000/xnobrain/api/control/v1/llm
RUNTIME_LLM_WORKLOAD_TOKEN=replace-with-provisioned-workload-token

# Optional local memory, telemetry, and runtime limits.
RUNTIME_HONCHO_MEMORY_ENABLE=false
RUNTIME_OTEL_TRACES_ENABLED=false
RUNTIME_SESSION_TIMEOUT_SECONDS=86400
RUNTIME_DELEGATION_MAX_CONCURRENT_CHILDREN=3
