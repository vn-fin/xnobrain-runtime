# XNOBrain Web identity. These values set the browser title, metadata, and UI headers.
XNOBRAIN_APP_NAME=XNOBrain
XNOBRAIN_APP_DESCRIPTION=Your private AI workspace for agents, conversations, skills, and automation.

# XNOBrain always uses authenticated cloud features. The workspace API remains
# local; only authentication and control-plane requests use these cloud APIs.
XNOBRAIN_WEB_EDITION=enterprise
XNOBRAIN_AUTH_BASE_URL=https://api.dev.xnoquant.io
XNOBRAIN_BRAIN_CONTROL_BASE_URL=https://public.dev.xno.vn
XNOBRAIN_FIREBASE_API_KEY=AIzaSyD8AFSR1vg21WOwLNVhczWfWfi3YSmZ9NA

# Required persistent runtime homes. Set both before starting or installing any
# service. For Docker, use paths inside the persisted /opt/data volume, such as
# /opt/data/agent and /opt/data/provider-runtime.
XNOBRAIN_AGENT_HOME=/opt/data/agent
XNOBRAIN_PROVIDER_DATA_DIR=/opt/data/provider-runtime

# Enable the free, self-hosted Honcho memory provider. Honcho uses the private
# provider endpoint for its background language-model work.
HONCHO_MEMORY_ENABLE=true

# Agent execution limits. Session timeouts default to 900 seconds and are
# always capped at one hour. Delegation defaults to 3 parallel workers and is
# always capped at 5; additional tasks remain queued.
XNOBRAIN_SESSION_TIMEOUT_SECONDS=900
XNOBRAIN_MAX_PARALLEL_AGENTS=3

# Root `make dev` network settings. Web and API are reachable from the LAN;
# the local provider process remains bound to loopback.
XNOBRAIN_DEV_WEB_HOST=0.0.0.0
XNOBRAIN_DEV_WEB_PORT=5173
XNOBRAIN_DEV_API_HOST=0.0.0.0
XNOBRAIN_DEV_API_PORT=8642
XNOBRAIN_DEV_ROUTER_HOST=127.0.0.1
XNOBRAIN_DEV_ROUTER_PORT=20128
