START_MODE=local
COMPOSE_PROFILES=local
OPEN_LUMORA_DOMAIN=localhost
OPEN_LUMORA_HTTP_PORT=80
OPEN_LUMORA_BACKEND_IMAGE=open-lumora-backend:local
OPEN_LUMORA_FRONTEND_IMAGE=open-lumora-frontend:local
OPEN_LUMORA_HERMES_IMAGE=open-lumora-hermes-runtime:compatible
CONTROL_GATEWAY_URL=
OPEN_LUMORA_EDITION=opensource
HTTP_PORT=3000
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DATA_DIR=data
FRONTEND_DIR=src/dist
HERMES_BIN=hermes
HERMES_GATEWAY_BIN=hermes-custom-gateway
# Use cli for host development; the container overrides this to gateway.
HERMES_RUNTIME_MODE=cli
HERMES_RUNTIME_URL=
HERMES_RUNTIME_TOKEN=
NINE_ROUTER_URL=http://127.0.0.1:20128
NINE_ROUTER_DATA_DIR=data/root/.9router
RUNTIME_TIMEOUT_SECONDS=900
CONTAINER_IDLE_ENABLED=true
CONTAINER_IDLE_TIMEOUT_MINUTES=30
MANAGED_WORKER_TOKEN=
PERMISSION_GRPC_HOST=
AUTH_TIMEOUT_SECONDS=1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_DISK_BUFFER_BYTES=67108864
DEVICE_CLOUD_URL=
# Base64url Ed25519 public key supplied by the paired control plane.
DEVICE_SIGNING_PUBLIC_KEY=
DEVICE_POLL_INTERVAL_SECONDS=20
VITE_API_BASE_URL=http://localhost:3000
DASHBOARD_ENABLED=true
# Review fixture. Set false before the production release.
DASHBOARD_SMOKE_DATA_ENABLED=true
CLICKHOUSE_PASSWORD=open-lumora-local
CLICKHOUSE_RETENTION_DAYS=7
SCHEDULER_ENABLED=true
