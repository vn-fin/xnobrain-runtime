START_MODE=local
OPEN_LUMORA_DOMAIN=localhost
OPEN_LUMORA_HTTP_PORT=80
OPEN_LUMORA_FRONTEND_IMAGE=open-lumora-frontend:local
HERMES_RUNTIME_IMAGE=open-lumora-hermes-runtime:local
# Runtime limits. Increase these values in .env when the host has capacity.
OPEN_LUMORA_RUNTIME_CPUS=4.0
OPEN_LUMORA_RUNTIME_MEMORY=4G
OPEN_LUMORA_RUNTIME_DISK_SIZE=100G
NINE_ROUTER_INTERNAL_SECRET=open-lumora-local-9router
# Optional. Local Hermes features work without this URL.
ENTERPRISE_API_URL=
TELEMETRY_RESOURCE_TOKEN=
API_SERVER_PORT=8642
LOG_LEVEL=debug
DATA_DIR=data
NINE_ROUTER_DATA_DIR=data/root/.9router
OTEL_EXPORTER_OTLP_ENDPOINT=
# Empty uses same-origin requests through Traefik. Vite proxies to port 8642.
VITE_API_BASE_URL=
