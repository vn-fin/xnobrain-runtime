# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS frontend-build
WORKDIR /app
ARG API_BASE_URL=""
ARG AUTH_BASE_URL=""
ARG API_CONTROL_BASE_URL=""
ARG APP_NAME="XNOBrain"
ARG APP_DESCRIPTION="Your private AI workspace for agents, conversations, skills, and automation."
ARG APP_EDITION="enterprise"
ARG AUTH_MODE="required"
ARG AUTH_PROVIDER="xno-firebase"
ARG FIREBASE_API_KEY=""
ENV XNOBRAIN_APP_NAME=${APP_NAME} \
    XNOBRAIN_APP_DESCRIPTION=${APP_DESCRIPTION} \
    VITE_API_BASE_URL=${API_BASE_URL} \
    VITE_AUTH_API_URL=${AUTH_BASE_URL} \
    VITE_CONTROL_API_BASE_URL=${API_CONTROL_BASE_URL} \
    VITE_APP_EDITION=${APP_EDITION} \
    VITE_AUTH_MODE=${AUTH_MODE} \
    VITE_AUTH_PROVIDER=${AUTH_PROVIDER} \
    VITE_FIREBASE_API_KEY=${FIREBASE_API_KEY}
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json tsconfig.node.json ./
COPY public/ ./public/
COPY src/ ./src/
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=10 CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
