[Unit]
Description=XNOBrain OmniRoute provider runtime
Documentation=https://github.com/vn-fin/xnobrain
After=network-online.target xnobrain-prepare.service
Wants=network-online.target
Requires=xnobrain-prepare.service
ConditionPathExists=/etc/xnobrain/xnobrain.env
PartOf=xnobrain.target

[Service]
Type=simple
User=xnobrain
Group=xnobrain
WorkingDirectory=/opt/xnobrain
EnvironmentFile=/etc/xnobrain/xnobrain.env
Environment=PATH=/opt/xnobrain/.tools/node/bin:/opt/xnobrain/.tools/npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=PORT=20128
Environment=HOSTNAME=127.0.0.1
Environment=API_PORT=20128
Environment=DASHBOARD_PORT=20128
Environment=REQUIRE_API_KEY=false
Environment=NODE_ENV=production
Environment=OMNIROUTE_NO_UPDATE_NOTIFIER=1
ExecStartPre=/opt/xnobrain/scripts/prepare-service-data.sh
ExecStart=/usr/bin/env DATA_DIR=${OMNIROUTE_DATA_DIR} PORT=20128 API_PORT=20128 DASHBOARD_PORT=20128 HOSTNAME=127.0.0.1 REQUIRE_API_KEY=false NODE_ENV=production OMNIROUTE_NO_UPDATE_NOTIFIER=1 /opt/xnobrain/.tools/npm-global/bin/omniroute serve --port 20128 --no-open
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/xnobrain-data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=xnobrain.target
