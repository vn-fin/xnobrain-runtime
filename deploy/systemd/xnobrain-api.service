[Unit]
Description=XNOBrain FastAPI and Hermes runtime
Documentation=https://github.com/vn-fin/xnobrain
After=network-online.target xnobrain-prepare.service
Wants=network-online.target
Requires=xnobrain-prepare.service
ConditionPathExists=/etc/xnobrain/xnobrain.env
PartOf=xnobrain.target

[Service]
Type=simple
User=xnobrain
Group=xnobrain
WorkingDirectory=/opt/xnobrain
EnvironmentFile=/etc/xnobrain/xnobrain.env
Environment=PATH=/opt/xnobrain/.tools/node/bin:/opt/xnobrain/.tools/npm-global/bin:/opt/xnobrain/.tools/hermes-agent/venv/bin:/opt/xnobrain/.tools/office-python/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=HERMES_CLI=/opt/xnobrain/.tools/npm-global/bin/agent
Environment=HERMES_RUNTIME_PYTHON=/opt/xnobrain/.tools/hermes-agent/venv/bin/python
ExecStartPre=/opt/xnobrain/scripts/prepare-service-data.sh
ExecStart=/usr/bin/env HOME=${RUNTIME_HOME} HERMES_HOME=${RUNTIME_HERMES_HOME} HERMES_ROOT_PROFILE=${RUNTIME_HERMES_HOME} HERMES_PROFILES_ROOT=${RUNTIME_HERMES_PROFILES_ROOT} RUNTIME_LLM_GATEWAY_URL=${RUNTIME_LLM_GATEWAY_URL} RUNTIME_LLM_MANAGEMENT_URL=${RUNTIME_LLM_MANAGEMENT_URL} RUNTIME_LLM_WORKLOAD_TOKEN=${RUNTIME_LLM_WORKLOAD_TOKEN} OMNIROUTE_API_KEY=${RUNTIME_LLM_WORKLOAD_TOKEN} API_SERVER_HOST=${RUNTIME_API_SERVER_HOST} API_SERVER_PORT=${RUNTIME_API_SERVER_PORT} DATA_DIR=${RUNTIME_DATA_DIR} DEVELOPMENT_ENVIRONMENT=${RUNTIME_DEVELOPMENT_ENVIRONMENT} SERVICE_NAME=${RUNTIME_SERVICE_NAME} OTEL_ENABLED=${RUNTIME_OTEL_TRACES_ENABLED} OTEL_EXPORTER_OTLP_ENDPOINT=${RUNTIME_OTEL_EXPORTER_OTLP_ENDPOINT} /opt/xnobrain/.tools/python/bin/python /opt/xnobrain/server.py
Restart=on-failure
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=120
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/xnobrain-data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=xnobrain.target
