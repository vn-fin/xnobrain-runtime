HOME=/srv/xnobrain-data/home
# Required. Enter paths writable by the xnobrain service user.
HERMES_HOME=
OMNIROUTE_DATA_DIR=
DATA_DIR=/srv/xnobrain-data/xnobrain
OMNIROUTE_URL=http://127.0.0.1:20128
OMNIROUTE_CLI_SALT=omniroute-cli-auth-v1
NODE_USE_ENV_PROXY=1
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
XNOBRAIN_RELOAD=0
DEVELOPMENT_ENVIRONMENT=production
SERVICE_NAME=xnobrain-runtime-services
OTEL_ENABLED=false
