RUNTIME_HOME=/srv/xnobrain-data/home
# Required. Enter paths writable by the xnobrain service user.
RUNTIME_HERMES_HOME=
RUNTIME_HERMES_PROFILES_ROOT=
RUNTIME_OMNIROUTE_DATA_DIR=
RUNTIME_OMNIROUTE_URL=http://127.0.0.1:20128
RUNTIME_OMNIROUTE_CLI_SALT=omniroute-cli-auth-v1
RUNTIME_NODE_USE_ENV_PROXY=1
RUNTIME_API_SERVER_HOST=0.0.0.0
RUNTIME_API_SERVER_PORT=3000
RUNTIME_RELOAD=0
RUNTIME_DATA_DIR=/srv/xnobrain-data/xnobrain
RUNTIME_DEVELOPMENT_ENVIRONMENT=production
RUNTIME_SERVICE_NAME=xnobrain-runtime-services
RUNTIME_OTEL_TRACES_ENABLED=false
