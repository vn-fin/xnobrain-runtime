[Unit]
Description=Brain4All FastAPI and Hermes runtime
Documentation=https://github.com/vn-fin/brain4all
After=network-online.target brain4all-prepare.service brain4all-9router.service
Wants=network-online.target brain4all-9router.service
Requires=brain4all-prepare.service
ConditionPathExists=/etc/brain4all/brain4all.env
PartOf=brain4all.target

[Service]
Type=simple
User=brain4all
Group=brain4all
WorkingDirectory=/opt/brain4all
EnvironmentFile=/etc/brain4all/brain4all.env
Environment=PATH=/opt/brain4all/.tools/node/bin:/opt/brain4all/.tools/npm-global/bin:/opt/brain4all/.tools/hermes-agent/venv/bin:/opt/brain4all/.tools/office-python/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=HERMES_CLI=/opt/brain4all/.tools/npm-global/bin/agent
Environment=HERMES_RUNTIME_PYTHON=/opt/brain4all/.tools/hermes-agent/venv/bin/python
ExecStartPre=/opt/brain4all/scripts/prepare-service-data.sh
ExecStart=/opt/brain4all/.tools/python/bin/python /opt/brain4all/server.py
Restart=on-failure
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=120
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/brain4all-data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=brain4all.target
