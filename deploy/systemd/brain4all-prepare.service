[Unit]
Description=Prepare Brain4All persistent data volume
Before=brain4all-9router.service brain4all-api.service
ConditionPathExists=/etc/brain4all/brain4all.env
PartOf=brain4all.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/brain4all/brain4all.env
Environment=BRAIN4ALL_SERVICE_USER=brain4all
ExecStart=/opt/brain4all/scripts/prepare-service-data.sh
RemainAfterExit=yes

[Install]
WantedBy=brain4all.target
