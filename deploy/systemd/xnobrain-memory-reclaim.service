[Unit]
Description=XNOBrain bounded clean guest page-cache eviction
Requires=xnobrain-memory-reclaim.socket
After=xnobrain-memory-reclaim.socket

[Service]
Type=exec
User=root
Group=xnobrain
EnvironmentFile=/etc/xnobrain/xnobrain.env
ExecStart=/usr/bin/python3 -I /usr/local/libexec/xnobrain-memory-reclaim.py
RuntimeMaxSec=5
TimeoutStopSec=1
KillMode=control-group
SendSIGKILL=yes
Restart=no
StateDirectory=xnobrain-memory-reclaim
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelLogs=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/proc/sys/vm/drop_caches
TasksMax=4
MemoryMax=64M
StandardOutput=null
StandardError=null
