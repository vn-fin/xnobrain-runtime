[Unit]
Description=Prepare XNOBrain persistent data volume
Before=xnobrain-omniroute.service xnobrain-api.service
ConditionPathExists=/etc/xnobrain/xnobrain.env
PartOf=xnobrain.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/xnobrain/xnobrain.env
Environment=XNOBRAIN_SERVICE_USER=xnobrain
ExecStart=/opt/xnobrain/scripts/prepare-service-data.sh
RemainAfterExit=yes

[Install]
WantedBy=xnobrain.target
