node_modules/
node_modules*/
.vite/
.npm/
*.tsbuildinfo
vite.config.js
vite.config.d.ts
storybook-static/

# The production UI is copied into the frontend image and remains committed.
/dist/
!/dist/
!/dist/**

# ─── Environment & secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
.env.local

# ─── Data & runtime dirs ──────────────────────────────────────────────────────
data/
*.db
*.sqlite
*.sqlite3

# Log files
*.log
logs/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.Python
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
*.egg-info/

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
