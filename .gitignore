*.key
*.crt
tmp/

# Local browser profile generated by review tooling
reviews/browser-profile/

# Deliberate native release outputs. Linux ships first as one AppImage; native
# Windows/macOS artifacts can be added here when built on their target hosts.
!/binary/
!/binary/**
binary/*.AppImage

# Local container image archive parts are build artifacts, not source.
bin/images/open-lumora-images-local.tar.gz.part-*
