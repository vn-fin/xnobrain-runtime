# syntax=docker/dockerfile:1.7
FROM golang:1.26.5-bookworm AS studio-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY services ./services
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/open-lumora ./cmd

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home /opt/open-lumora lumora \
    && mkdir -p /opt/data/open-lumora /opt/open-lumora/frontend \
    && chown -R lumora:lumora /opt/data /opt/open-lumora
COPY --from=studio-build /out/open-lumora /usr/local/bin/open-lumora
COPY deploy/backend-entrypoint.sh /usr/local/bin/open-lumora-entrypoint
RUN chmod 0755 /usr/local/bin/open-lumora-entrypoint
ENTRYPOINT ["/usr/local/bin/open-lumora-entrypoint"]
EXPOSE 3000
