# syntax=docker/dockerfile:1.7
FROM node:22.23.1-bookworm AS node-runtime

FROM ubuntu:24.04 AS runtime-base

ARG DEBIAN_FRONTEND=noninteractive
ARG HERMES_VERSION=v2026.8.16
ARG HERMES_COMMIT=df4b65147d7ddd74dd449f9067aabbca5aef0ec7
ENV TZ=Etc/UTC \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

# Use the supported Node 22 runtime for Hermes and agent CLIs. The
# binary is built on an older glibc than Ubuntu 24.04, so it remains portable.
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=node-runtime /usr/local/lib/node_modules/corepack /usr/local/lib/node_modules/corepack
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -sf /usr/local/lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack

USER root
# This mirrors the full Ubuntu office/engineering image used by the sandbox
# builder. Keep Ubuntu sources and downloaded package indexes in the final image
# so the root agent can install additional tools without an initial apt update.
RUN printf '%s\n' \
      'ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true' \
      | debconf-set-selections \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      antiword bash-completion build-essential ca-certificates \
      catdoc csvkit curl default-jre-headless dnsutils docx2txt ffmpeg file \
      fontconfig fonts-crosextra-caladea fonts-crosextra-carlito fonts-dejavu \
      fonts-freefont-ttf fonts-liberation fonts-liberation2 fonts-noto \
      fonts-noto-cjk fonts-noto-color-emoji fonts-urw-base35 ghostscript git \
      gnupg htop hunspell-en-us hunspell-vi hyphen-en-us \
      imagemagick img2pdf iproute2 iputils-ping jq less libffi-dev \
      libimage-exiftool-perl libreoffice-calc libreoffice-draw libreoffice-impress \
      libreoffice-math libreoffice-writer locales lsb-release \
      lsof mtr-tiny mythes-en-us nano netcat-openbsd \
      ocrmypdf odt2txt openssh-client pandoc pdftk-java pkg-config poppler-utils \
      procps psmisc python3 python3-dev python3-pip \
      python3-uno python3-venv qpdf ripgrep rsync socat \
      software-properties-common sqlite3 strace \
      sudo tar tcpdump tesseract-ocr tesseract-ocr-eng tesseract-ocr-vie tmux \
      traceroute tree ttf-mscorefonts-installer unoconv unzip vim weasyprint \
      wget wv xlsx2csv xz-utils zip \
    && install -d /etc/fonts/conf.d \
    && printf '%s\n' \
      '<?xml version="1.0"?>' \
      '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">' \
      '<fontconfig>' \
      '  <alias><family>Calibri</family><prefer><family>Carlito</family></prefer></alias>' \
      '  <alias><family>Cambria</family><prefer><family>Caladea</family></prefer></alias>' \
      '  <alias><family>Aptos</family><prefer><family>Carlito</family></prefer></alias>' \
      '  <alias><family>Aptos Serif</family><prefer><family>Caladea</family></prefer></alias>' \
      '</fontconfig>' \
      > /etc/fonts/conf.d/60-hermes-office-font-aliases.conf \
    && fc-cache -f

# Intentionally excluded to keep the per-user runtime image smaller. Restore a
# package here if a concrete workspace regression requires it:
# - postgresql, postgresql-contrib: no database server is started or used by the
#   file-backed runtime; managed PostgreSQL belongs to the control plane.
# - redis-server, redis-tools: no Redis process or client exists in this image's
#   runtime contract.
# - libreoffice (meta), libreoffice-base, libreoffice-java-common,
#   libreoffice-script-provider-python: Writer/Calc/Impress/Draw/Math and UNO
#   retain DOCX/XLSX/PPTX editing, conversion, and preview support.
# - gnumeric: LibreOffice Calc and the Python spreadsheet libraries cover it.
# - graphicsmagick: ImageMagick supplies the retained image CLI operations.
# - wkhtmltopdf: WeasyPrint and the installed browser cover HTML/PDF rendering.
# - apt-transport-https: HTTPS transport is built into Ubuntu 24.04 APT.
# - man-db, manpages: reference manuals are not needed by the runtime service.
# - net-tools: iproute2 supplies the maintained network commands.

# Install Hermes directly on Ubuntu using its supported root/FHS layout. A
# disposable build home prevents image build state from becoming user data;
# runtime profiles remain exclusively under /opt/data. Installer download and
# compiler caches speed up rebuilds without becoming runtime image content.
RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.cache/node-gyp \
    curl -fsSL "https://raw.githubusercontent.com/NousResearch/hermes-agent/${HERMES_COMMIT}/scripts/install.sh" \
      | env HERMES_HOME=/opt/hermes-build-home bash -s -- \
          --branch "${HERMES_VERSION}" --commit "${HERMES_COMMIT}" \
          --force-commit --skip-setup --non-interactive \
    && install -m 0755 /opt/hermes-build-home/bin/uv /usr/local/bin/uv \
    && test "$(git -C /usr/local/lib/hermes-agent rev-parse HEAD)" = "${HERMES_COMMIT}" \
    && uv pip install --python /usr/local/lib/hermes-agent/venv/bin/python \
      'edge-tts==7.2.7' \
    && rm -rf /opt/hermes-build-home

# Match the interactive sandbox image: office Python helpers and common agent
# CLIs are ready immediately instead of being lazily downloaded at first use.
ARG AGENT_BROWSER_VERSION=0.26.0
RUN python3 -m venv /opt/hermes-office-tools \
    && /opt/hermes-office-tools/bin/python -m pip install --no-cache-dir --upgrade \
      pip setuptools wheel \
    && /opt/hermes-office-tools/bin/python -m pip install --no-cache-dir --upgrade \
      'markitdown[pdf,docx,pptx,xlsx,xls,outlook]' \
      beautifulsoup4 docx2python extract-msg lxml mammoth markdown numpy odfpy \
      openpyxl pandas pdfplumber pikepdf pillow pymupdf pypdf pyxlsb pytesseract \
      python-docx python-magic python-pptx pyyaml reportlab xlrd xlwt xlsxwriter \
    && ln -sf /opt/hermes-office-tools/bin/python /usr/local/bin/office-python \
    && ln -sf /opt/hermes-office-tools/bin/pip /usr/local/bin/office-pip \
    && ln -sf /opt/hermes-office-tools/bin/markitdown /usr/local/bin/markitdown

# Keep each independent runtime tool in its own layer. This gives registry
# retries small boundaries and lets an unchanged tool reuse its cached layer.
# The npm cache speeds up rebuilds but is not shipped in any image layer.
RUN --mount=type=cache,target=/root/.npm \
    npm install -g --no-audit --no-fund --include=optional \
      "agent-browser@${AGENT_BROWSER_VERSION}"

RUN --mount=type=cache,target=/root/.npm \
    npm install -g --no-audit --no-fund --include=optional pnpm

RUN agent-browser install --with-deps

COPY requirements.txt /opt/xnobrain/requirements.txt
COPY THIRD_PARTY_NOTICES.md /opt/xnobrain/THIRD_PARTY_NOTICES.md
COPY third_party_licenses /opt/xnobrain/third_party_licenses
RUN uv pip install --python /usr/local/lib/hermes-agent/venv/bin/python \
      -r /opt/xnobrain/requirements.txt \
    && rm /opt/xnobrain/requirements.txt

FROM runtime-base AS endpoint-builder

ARG BUILD_MODE=source
WORKDIR /opt/xnobrain-build
COPY xnobrain ./xnobrain
COPY server.py ./server.py
RUN if [ "${BUILD_MODE}" = "source" ]; then \
      install -d /opt/xnobrain-artifact \
      && cp -a xnobrain /opt/xnobrain-artifact/xnobrain \
      && cp server.py /opt/xnobrain-artifact/server.py \
      && touch /opt/xnobrain-artifact/source-mode; \
    else \
      apt-get update \
      && apt-get install -y --no-install-recommends ccache patchelf \
      && rm -rf /var/lib/apt/lists/* \
      && uv pip install --python /usr/local/lib/hermes-agent/venv/bin/python 'nuitka[onefile]==4.1.3' \
      && case "${BUILD_MODE}" in \
        onefile) nuitka_mode="--mode=onefile --onefile-tempdir-spec={TEMP}/xnobrain-runtime-${HERMES_COMMIT}" ;; \
        module) nuitka_mode='--mode=standalone' ;; \
        *) echo "BUILD_MODE must be source, onefile or module; got: ${BUILD_MODE}" >&2; exit 2 ;; \
      esac \
      && /usr/local/lib/hermes-agent/venv/bin/python -m nuitka \
        ${nuitka_mode} --assume-yes-for-downloads --lto=no \
        --output-dir=/opt/xnobrain-dist --output-filename=xnobrain-runtime \
        --include-package=xnobrain --include-package=hermes_cli \
        --include-module=hermes_constants --include-module=hermes_state \
        --include-package=gateway --include-package=tools \
        --include-package-data=xnobrain --nofollow-import-to='*.tests' server.py \
      && install -d /opt/xnobrain-artifact \
      && case "${BUILD_MODE}" in \
        onefile) cp /opt/xnobrain-dist/xnobrain-runtime /opt/xnobrain-artifact/app.so ;; \
        module) cp -a /opt/xnobrain-dist/server.dist/. /opt/xnobrain-artifact/; mv /opt/xnobrain-artifact/xnobrain-runtime /opt/xnobrain-artifact/app.so ;; \
      esac \
      && test -x /opt/xnobrain-artifact/app.so; \
    fi

FROM runtime-base AS runtime
ARG BUILD_MODE=source
COPY --from=endpoint-builder /opt/xnobrain-artifact /opt/xnobrain-app

RUN if [ "${BUILD_MODE}" != "source" ]; then ln -s /opt/xnobrain-app/app.so /usr/local/bin/app.so; fi

ARG RUN_ENV=dev
LABEL com.xno.run-environment="${RUN_ENV}"

COPY runtime/profile-templates /opt/xnobrain/profile-templates
COPY runtime/required-skills /opt/xnobrain/required-skills
COPY runtime/skill-overrides /opt/xnobrain/skill-overrides
COPY scripts/apply-profile-templates.sh /usr/local/bin/xnobrain-apply-profile-templates
COPY runtime/container-entrypoint.sh /usr/local/bin/xnobrain-runtime
COPY runtime/systemd-entrypoint.sh /usr/local/bin/xnobrain-systemd-entrypoint
COPY runtime/xnobrain-runtime.service /etc/systemd/system/xnobrain-runtime.service
COPY runtime/10-incus-eth0.network /etc/systemd/network/10-incus-eth0.network
COPY runtime/prepare-resolv-conf.sh /usr/local/bin/xnobrain-prepare-resolv-conf
COPY runtime/xnobrain-resolv-conf.service /etc/systemd/system/xnobrain-resolv-conf.service
RUN install -d -m 0700 /opt/data /opt/data/home /opt/data/home/.config \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      systemd-resolved \
    && chmod 0755 /usr/local/bin/xnobrain-runtime /usr/local/bin/xnobrain-systemd-entrypoint /usr/local/bin/xnobrain-prepare-resolv-conf /usr/local/bin/xnobrain-apply-profile-templates \
    && if [ "${BUILD_MODE}" != "source" ]; then chmod 0755 /usr/local/bin/app.so; fi \
    && ln -sfn /usr/local/lib/hermes-agent/venv/bin/hermes /usr/local/bin/agent \
    && ln -sfn /etc/systemd/system/xnobrain-runtime.service \
      /etc/systemd/system/multi-user.target.wants/xnobrain-runtime.service \
    && ln -sfn /usr/lib/systemd/system/systemd-networkd.service \
      /etc/systemd/system/multi-user.target.wants/systemd-networkd.service \
    && ln -sfn /usr/lib/systemd/system/systemd-resolved.service \
      /etc/systemd/system/multi-user.target.wants/systemd-resolved.service \
    && ln -sfn /etc/systemd/system/xnobrain-resolv-conf.service \
      /etc/systemd/system/sysinit.target.wants/xnobrain-resolv-conf.service

ENV XNOBRAIN_BUILD_MODE=${BUILD_MODE} \
    PATH="/usr/local/lib/hermes-agent/venv/bin:/opt/hermes-office-tools/bin:/usr/local/bin:${PATH}" \
    RUN_ENV=${RUN_ENV} \
    HERMES_INSTALL_DIR=/usr/local/lib/hermes-agent \
    HERMES_RUNTIME_PYTHON=/usr/local/lib/hermes-agent/venv/bin/python \
    HERMES_CLI=/usr/local/bin/agent \
    HERMES_DESKTOP=1 \
    HOME=/opt/data/home \
    XDG_CONFIG_HOME=/opt/data/home/.config \
    API_SERVER_HOST=0.0.0.0 \
    API_SERVER_PORT=3000

# Incus workspaces keep /opt/data inside the quota-limited root filesystem or
# attach an explicit managed volume. Declaring an OCI VOLUME makes Incus
# convert it into an invalid source=none tmpfs mount.
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --retries=10 CMD curl --fail --silent --show-error --max-time 2 http://127.0.0.1:3000/xnobrain/api/runtime/v1/health >/dev/null || exit 1
USER root
ENTRYPOINT ["/usr/local/bin/xnobrain-runtime"]
