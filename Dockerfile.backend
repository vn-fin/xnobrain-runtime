# syntax=docker/dockerfile:1.7
ARG BUILD_MODE=module
FROM node:22.23.1-bookworm AS node-runtime

FROM ubuntu:24.04 AS runtime-base

ARG DEBIAN_FRONTEND=noninteractive
ARG HERMES_VERSION=v2026.8.16
ARG HERMES_COMMIT=df4b65147d7ddd74dd449f9067aabbca5aef0ec7
ARG OMNIROUTE_VERSION=3.8.49
ARG CODEX_CLI_VERSION=0.144.6
ARG CLAUDE_CODE_VERSION=2.1.216

ENV TZ=Etc/UTC \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

# Use the supported Node 22 runtime for Hermes, OmniRoute, and agent CLIs. The
# binary is built on an older glibc than Ubuntu 24.04, so it remains portable.
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=node-runtime /usr/local/lib/node_modules/corepack /usr/local/lib/node_modules/corepack
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -sf /usr/local/lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack

USER root
# This mirrors the full Ubuntu office/engineering image used by the sandbox
# builder. Keep Ubuntu sources and downloaded package indexes in the final image
# so the root agent can install additional tools without an initial apt update.
RUN printf '%s\n' \
      'ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true' \
      | debconf-set-selections \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y \
      antiword apt-transport-https bash-completion build-essential ca-certificates \
      catdoc csvkit curl default-jre-headless dnsutils docx2txt ffmpeg file \
      fontconfig fonts-crosextra-caladea fonts-crosextra-carlito fonts-dejavu \
      fonts-freefont-ttf fonts-liberation fonts-liberation2 fonts-noto \
      fonts-noto-cjk fonts-noto-color-emoji fonts-urw-base35 ghostscript git \
      gnumeric gnupg graphicsmagick htop hunspell-en-us hunspell-vi hyphen-en-us \
      imagemagick img2pdf iproute2 iputils-ping jq less libffi-dev \
      libimage-exiftool-perl libreoffice libreoffice-base libreoffice-calc \
      libreoffice-draw libreoffice-impress libreoffice-java-common libreoffice-math \
      libreoffice-script-provider-python libreoffice-writer locales lsb-release \
      lsof man-db manpages mtr-tiny mythes-en-us nano net-tools netcat-openbsd \
      ocrmypdf odt2txt openssh-client pandoc pdftk-java pkg-config poppler-utils \
      postgresql postgresql-contrib procps psmisc python3 python3-dev python3-pip \
      python3-uno python3-venv qpdf redis-server redis-tools ripgrep rsync socat \
      software-properties-common sqlite3 strace \
      sudo tar tcpdump tesseract-ocr tesseract-ocr-eng tesseract-ocr-vie tmux \
      traceroute tree ttf-mscorefonts-installer unoconv unzip vim weasyprint \
      wget wkhtmltopdf wv xlsx2csv xz-utils zip \
    && install -d /etc/fonts/conf.d \
    && printf '%s\n' \
      '<?xml version="1.0"?>' \
      '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">' \
      '<fontconfig>' \
      '  <alias><family>Calibri</family><prefer><family>Carlito</family></prefer></alias>' \
      '  <alias><family>Cambria</family><prefer><family>Caladea</family></prefer></alias>' \
      '  <alias><family>Aptos</family><prefer><family>Carlito</family></prefer></alias>' \
      '  <alias><family>Aptos Serif</family><prefer><family>Caladea</family></prefer></alias>' \
      '</fontconfig>' \
      > /etc/fonts/conf.d/60-hermes-office-font-aliases.conf \
    && fc-cache -f

# Install Hermes directly on Ubuntu using its supported root/FHS layout. A
# disposable build home prevents image build state from becoming user data;
# runtime profiles remain exclusively under /opt/data.
RUN curl -fsSL "https://raw.githubusercontent.com/NousResearch/hermes-agent/${HERMES_COMMIT}/scripts/install.sh" \
      | env HERMES_HOME=/opt/hermes-build-home bash -s -- \
          --branch "${HERMES_VERSION}" --commit "${HERMES_COMMIT}" \
          --force-commit --skip-setup --non-interactive \
    && install -m 0755 /opt/hermes-build-home/bin/uv /usr/local/bin/uv \
    && test "$(git -C /usr/local/lib/hermes-agent rev-parse HEAD)" = "${HERMES_COMMIT}" \
    && uv pip install --python /usr/local/lib/hermes-agent/venv/bin/python \
      'edge-tts==7.2.7'

# Match the interactive sandbox image: office Python helpers and common agent
# CLIs are ready immediately instead of being lazily downloaded at first use.
ARG AGENT_BROWSER_VERSION=0.26.0
RUN python3 -m venv /opt/hermes-office-tools \
    && /opt/hermes-office-tools/bin/python -m pip install --no-cache-dir --upgrade \
      pip setuptools wheel \
    && /opt/hermes-office-tools/bin/python -m pip install --no-cache-dir --upgrade \
      'markitdown[pdf,docx,pptx,xlsx,xls,outlook]' \
      beautifulsoup4 docx2python extract-msg lxml mammoth markdown numpy odfpy \
      openpyxl pandas pdfplumber pikepdf pillow pymupdf pypdf pyxlsb pytesseract \
      python-docx python-magic python-pptx pyyaml reportlab xlrd xlwt xlsxwriter \
    && ln -sf /opt/hermes-office-tools/bin/python /usr/local/bin/office-python \
    && ln -sf /opt/hermes-office-tools/bin/pip /usr/local/bin/office-pip \
    && ln -sf /opt/hermes-office-tools/bin/markitdown /usr/local/bin/markitdown \
    && npm install -g --no-audit --no-fund --include=optional \
      "omniroute@${OMNIROUTE_VERSION}" \
      "@openai/codex@${CODEX_CLI_VERSION}" \
      "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
      "agent-browser@${AGENT_BROWSER_VERSION}" \
      pnpm \
    && agent-browser install --with-deps

COPY requirements.txt /opt/xnobrain/requirements.txt
COPY THIRD_PARTY_NOTICES.md /opt/xnobrain/THIRD_PARTY_NOTICES.md
COPY third_party_licenses /opt/xnobrain/third_party_licenses
RUN uv pip install --python /usr/local/lib/hermes-agent/venv/bin/python \
      -r /opt/xnobrain/requirements.txt \
    && rm /opt/xnobrain/requirements.txt

FROM runtime-base AS endpoint-module-builder

WORKDIR /opt/xnobrain-build
RUN apt-get update \
    && apt-get install -y --no-install-recommends ccache \
    && rm -rf /var/lib/apt/lists/* \
    && uv pip install --python /usr/local/lib/hermes-agent/venv/bin/python \
      'nuitka==4.1.3'
COPY xnobrain ./xnobrain
RUN --mount=type=cache,target=/root/.cache/ccache \
    /usr/local/lib/hermes-agent/venv/bin/python -m nuitka \
      --mode=module \
      --output-dir=/opt/xnobrain-dist \
      --include-package=xnobrain \
      --nofollow-import-to='*.tests' \
      xnobrain \
    && test "$(find /opt/xnobrain-dist -maxdepth 1 -name 'xnobrain*.so' | wc -l)" -eq 1

FROM runtime-base AS endpoint-onefile-builder

WORKDIR /opt/xnobrain-build
RUN apt-get update \
    && apt-get install -y --no-install-recommends ccache patchelf \
    && rm -rf /var/lib/apt/lists/* \
    && uv pip install --python /usr/local/lib/hermes-agent/venv/bin/python \
      'nuitka[onefile]==4.1.3'
COPY xnobrain ./xnobrain
COPY server.py ./server.py
RUN --mount=type=cache,target=/root/.cache/ccache \
    /usr/local/lib/hermes-agent/venv/bin/python -m nuitka \
      --mode=onefile \
      --assume-yes-for-downloads \
      --output-dir=/opt/xnobrain-dist \
      --output-filename=xnobrain-endpoint \
      --onefile-tempdir-spec="{TEMP}/xnobrain-endpoint-${HERMES_COMMIT}" \
      --include-package=xnobrain \
      --include-package=hermes_cli \
      --include-module=hermes_constants \
      --include-module=hermes_state \
      --include-package=gateway \
      --include-package=tools \
      --include-package-data=xnobrain \
      --nofollow-import-to='*.tests' \
      server.py \
    && test -x /opt/xnobrain-dist/xnobrain-endpoint

FROM runtime-base AS runtime-module

COPY --from=endpoint-module-builder /opt/xnobrain-dist/xnobrain*.so /opt/xnobrain-compiled/
COPY xnobrain/assets /opt/xnobrain-compiled/xnobrain/assets
COPY runtime/module-endpoint.sh /usr/local/bin/xnobrain-endpoint

FROM runtime-base AS runtime-onefile

COPY --from=endpoint-onefile-builder /opt/xnobrain-dist/xnobrain-endpoint /usr/local/bin/xnobrain-endpoint

ARG BUILD_MODE
FROM runtime-${BUILD_MODE}

ARG BUILD_MODE
ARG RUN_ENV=dev
LABEL com.xno.run-environment="${RUN_ENV}" \
      com.xno.build-mode="${BUILD_MODE}"

COPY runtime/profile-templates /opt/xnobrain/profile-templates
COPY runtime/skill-overrides /opt/xnobrain/skill-overrides
COPY scripts/apply-profile-templates.sh /usr/local/bin/xnobrain-apply-profile-templates
COPY runtime/container-entrypoint.sh /usr/local/bin/xnobrain-runtime
COPY runtime/prepare-omniroute-auth.sh /usr/local/bin/xnobrain-prepare-omniroute-auth
RUN install -d -m 0700 /opt/data /opt/data/home /opt/data/home/.config \
    && chmod 0755 /usr/local/bin/xnobrain-runtime /usr/local/bin/xnobrain-prepare-omniroute-auth /usr/local/bin/xnobrain-apply-profile-templates \
      /usr/local/bin/xnobrain-endpoint \
    && ln -sfn /usr/local/lib/hermes-agent/venv/bin/hermes /usr/local/bin/agent \
    && apt-get update

ENV PATH="/usr/local/lib/hermes-agent/venv/bin:/opt/hermes-office-tools/bin:/usr/local/bin:${PATH}" \
    RUN_ENV=${RUN_ENV} \
    HERMES_INSTALL_DIR=/usr/local/lib/hermes-agent \
    HERMES_RUNTIME_PYTHON=/usr/local/lib/hermes-agent/venv/bin/python \
    HERMES_CLI=/usr/local/bin/agent \
    HERMES_DESKTOP=1 \
    HOME=/opt/data/home \
    XDG_CONFIG_HOME=/opt/data/home/.config \
    API_SERVER_HOST=0.0.0.0 \
    API_SERVER_PORT=3000

VOLUME ["/opt/data"]
EXPOSE 3000 20128
HEALTHCHECK --interval=15s --timeout=3s --retries=10 CMD curl --fail --silent --show-error --max-time 2 http://127.0.0.1:3000/xnobrain/api/runtime/v1/health >/dev/null || exit 1
USER root
ENTRYPOINT ["/usr/local/bin/xnobrain-runtime"]
